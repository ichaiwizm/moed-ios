default_platform(:ios)

APP_IDENTIFIER = "com.wizycode.moed"
SCHEME        = "Moed"

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_P8_BASE64"],
    is_key_content_base64: true,
    in_house: false
  )
end

platform :ios do
  desc "Build + upload TestFlight"
  lane :beta do
    api_key = asc_api_key

    # (project.yml) ; xcodebuild résout BUILD_NUMBER (= github.run_number, exporté
    # par le workflow) au moment du build. Monotone, sans collision TestFlight.

    match(type: "appstore", api_key: api_key, readonly: false)

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "#{SCHEME}.xcodeproj",
      team_id: ENV["TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: APP_IDENTIFIER,
      profile_name: "match AppStore #{APP_IDENTIFIER}"
    )

    build_app(
      scheme: SCHEME,
      export_method: "app-store",
      export_options: { signingStyle: "manual", provisioningProfiles: { APP_IDENTIFIER => "match AppStore #{APP_IDENTIFIER}" } }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build + soumission App Store (review)"
  lane :release do
    api_key = asc_api_key
    # Numéro de build via $(BUILD_NUMBER) (project.yml), pas d'increment ici.
    match(type: "appstore", api_key: api_key, readonly: false)

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "#{SCHEME}.xcodeproj",
      team_id: ENV["TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: APP_IDENTIFIER,
      profile_name: "match AppStore #{APP_IDENTIFIER}"
    )

    build_app(scheme: SCHEME, export_method: "app-store",
              export_options: { signingStyle: "manual", provisioningProfiles: { APP_IDENTIFIER => "match AppStore #{APP_IDENTIFIER}" } })
    upload_to_app_store(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false }
    )
  end
end
